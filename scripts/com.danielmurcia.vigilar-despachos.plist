<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.danielmurcia.vigilar-despachos</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/danielmurcia/Proyectos/opencode-gatekeeper/scripts/notify-stalled.sh</string>
    <string>15</string>
  </array>

  <!-- Cada 10 min. El aviso se deduplica por tramos de media hora, asi que un
       worker parado insiste sin machacar. -->
  <key>StartInterval</key>
  <integer>600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/danielmurcia/.local/state/gatekeeper/vigilante.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/danielmurcia/.local/state/gatekeeper/vigilante.err</string>
</dict>
</plist>
